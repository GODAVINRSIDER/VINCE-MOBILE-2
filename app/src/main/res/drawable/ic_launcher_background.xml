<?xml version="1.0" encoding="utf-8"?>
<!-- v2.8 - launcher icon background layer: deep navy with a faint cyan/magenta glow in opposite corners, matching the
     neon V logo. The mark itself is drawable-nodpi/ic_launcher_foreground.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#FF070B1A" android:endColor="#FF05070C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70dp" android:centerX="0.15" android:centerY="0.12"
                android:startColor="#3322D3EE" android:endColor="#0022D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70dp" android:centerX="0.88" android:centerY="0.9"
                android:startColor="#33EC4899" android:endColor="#00EC4899" />
        </shape>
    </item>
</layer-list>
