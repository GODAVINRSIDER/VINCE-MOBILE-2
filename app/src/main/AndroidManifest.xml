<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to reach the Gemini API directly - standalone brain, no PC involved -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Stage 5 - push-to-talk voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Stage 10 - required for ScreenCaptureService to run as a proper
         foreground service (Google's documented requirement for
         MediaProjection, enforced strictly from Android 14+). Harmless
         on older Android versions where it's simply not needed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage 8 - lets the system Camera app write a full-resolution
             photo somewhere VINCE can read it back, without VINCE needing
             its own camera permission (the Camera app handles that). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.godavin.vince.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Stage 10 - performs screen capture inside a proper foreground
             service, per Google's documented MediaProjection requirement. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
