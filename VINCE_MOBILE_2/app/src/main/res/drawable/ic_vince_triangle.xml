<?xml version="1.0" encoding="utf-8"?>
<!--
    Locked "VINCE 2.0" icon mark: two downward-pointing triangles (a
    larger outlined one, a smaller solid one nested inside it) shaped so
    the negative space between them reads as a "V" - wider/shallower
    than a plain equilateral triangle, apex pulled further down and the
    top corners pulled wider, matching the original reference image.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- outer outlined triangle, neon blue - wide and shallow, "V"-like -->
    <path
        android:pathData="M12,20.5 L3,4.5 L21,4.5 Z"
        android:fillColor="#00000000"
        android:strokeColor="#4CE1FF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round" />

    <!-- inner solid triangle, purple - same shallow proportions, nested -->
    <path
        android:pathData="M12,16.3 L6.9,7.1 L17.1,7.1 Z"
        android:fillColor="#8B5CF6" />
</vector>
